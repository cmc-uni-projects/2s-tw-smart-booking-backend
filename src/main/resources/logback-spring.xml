<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console + one log file per day: ${LOG_PATH}/backend-YYYY-MM-DD.log (LOG_PATH = logging.file.path, default "logs",
  relative to the working directory: the backend folder locally, /app in Docker, mounted to ./logs).
  Days and timestamps use Vietnam time (the container itself runs in UTC). Files older than 30 days (or beyond 1 GB in total) are deleted.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_DIR" value="${LOG_PATH:-logs}"/>
    <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS, Asia/Ho_Chi_Minh} %5p [%X{requestId:-}] %-40.40logger{39} : %m%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="DAILY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- no <file>: the current day's file already carries its date -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/backend-%d{yyyy-MM-dd, Asia/Ho_Chi_Minh}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="DAILY_FILE"/>
    </root>
</configuration>
