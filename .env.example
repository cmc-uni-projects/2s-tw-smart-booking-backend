# Copy to .env and fill in. Loaded by Spring (dotenv-java reads /app/.env) and by docker compose.
# Values below are LOCAL-DEV defaults for docker-compose.yml.

SERVER_PORT=8080

# --- Spring profile: local (default; emails go to Mailpit) or dev (real SMTP below) ---
SPRING_PROFILES_ACTIVE=local

# --- Liquibase: 'demo' also loads the demo dataset (accounts, hotels, bookings). Use 'prod' (default) elsewhere. ---
LIQUIBASE_CONTEXTS=demo

# --- Database (MySQL container) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=smart_booking
DB_USER_NAME=smart_booking
DB_USER_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- JWT (HS512 needs >= 64 bytes) — generate: openssl rand -hex 64 ---
JWT_SECRET=

# --- Frontend origin (OAuth2 redirect target) ---
FRONTEND_URL=http://localhost:5173

# --- OAuth2 (dummy values let the app start; social login won't work until real ones are set) ---
GOOGLE_CLIENT_ID=local-dummy
GOOGLE_CLIENT_SECRET=local-dummy
FACEBOOK_CLIENT_ID=local-dummy
FACEBOOK_CLIENT_SECRET=local-dummy

# --- Mail ---
# Profile local: always the local mail server (Mailpit, inbox UI http://localhost:8025); MAIL_HOST/PORT are ignored.
#   Outside docker it uses localhost:1025; override with LOCAL_MAIL_HOST / LOCAL_MAIL_PORT.
# Profile dev: real SMTP. MAIL_PASSWORD must be a Gmail *App Password*
#   (Google account > Security > 2-Step Verification > App passwords). MAIL_USERNAME is also the From address.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@travelmate.local
MAIL_PASSWORD=unused

# --- Logging: daily files in logs/backend-YYYY-MM-DD.log (LOG_PATH changes the folder) ---
LOG_LEVEL_SERVICE=INFO
LOG_SLOW_THRESHOLD_MS=1000

# --- Gemini AI (chatbot free-chat needs a real key) ---
GEMINI_API_KEY=local-dummy

# --- Object storage: MinIO stands in for Cloudflare R2 ---
# s3.localhost resolves to 127.0.0.1 in browsers, and to the host via extra_hosts inside the
# backend container, so presigned URLs work from both sides.
R2_ENDPOINT=http://s3.localhost:9000
R2_ACCESS_KEY=minioadmin
# MinIO requires >= 8 characters
R2_SECRET_KEY=change-me-min-8-chars
R2_BUCKET_NAME=smart-booking
